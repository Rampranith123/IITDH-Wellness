rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Global Hardened Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isEmailVerified() && request.auth.token.email == 'cs26bt042@iitdh.ac.in';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTime(t) {
      return t is string && t.size() == 5 && t.matches('^\\d{2}:\\d{2}$');
    }

    function isAllowlistedDoctor() {
      return isEmailVerified() &&
        exists(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email));
    }

    // ---------- Validation Blueprints ----------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'role',
          'rollNumber', 'uhid', 'hostelOrDept', 'linkedDoctorId',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role',
          'rollNumber', 'uhid', 'hostelOrDept', 'linkedDoctorId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.role in ['student', 'doctor'] &&
        data.rollNumber is string && data.rollNumber.size() <= 30 &&
        data.uhid is string && data.uhid.size() <= 40 &&
        data.hostelOrDept is string && data.hostelOrDept.size() <= 80 &&
        data.linkedDoctorId is string && data.linkedDoctorId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMoodEntry(data) {
      return data.keys().hasAll(['date', 'score', 'note', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['date', 'score', 'note', 'createdAt', 'updatedAt']) &&
        isValidDate(data.date) &&
        data.score is int && data.score >= 1 && data.score <= 5 &&
        data.note is string && data.note.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDoctorStatus(data) {
      return data.keys().hasAll([
          'doctorId', 'availabilityOverride', 'customNote',
          'assignedUid', 'updatedByUid', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'doctorId', 'availabilityOverride', 'customNote',
          'assignedUid', 'updatedByUid', 'updatedAt'
        ]) &&
        isValidId(data.doctorId) &&
        data.availabilityOverride in ['auto', 'available', 'in_consultation', 'on_leave'] &&
        data.customNote is string && data.customNote.size() <= 200 &&
        data.assignedUid is string && data.assignedUid.size() <= 128 &&
        isValidId(data.updatedByUid) &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'studentUid', 'studentName', 'studentRoll', 'studentUhid',
          'doctorId', 'doctorName', 'doctorSpec', 'assignedDoctorUid',
          'date', 'time', 'reason', 'doctorNotes', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentUid', 'studentName', 'studentRoll', 'studentUhid',
          'doctorId', 'doctorName', 'doctorSpec', 'assignedDoctorUid',
          'date', 'time', 'reason', 'doctorNotes', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.studentUid) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.studentRoll is string && data.studentRoll.size() <= 30 &&
        data.studentUhid is string && data.studentUhid.size() <= 40 &&
        isValidId(data.doctorId) &&
        data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 100 &&
        data.doctorSpec is string && data.doctorSpec.size() >= 1 && data.doctorSpec.size() <= 100 &&
        data.assignedDoctorUid is string && data.assignedDoctorUid.size() <= 128 &&
        isValidDate(data.date) &&
        isValidTime(data.time) &&
        data.reason is string && data.reason.size() <= 500 &&
        data.doctorNotes is string && data.doctorNotes.size() <= 1000 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAllowlistEntry(data) {
      return data.keys().hasAll(['email', 'assignedDoctorId', 'doctorName', 'approvedByUid', 'createdAt']) &&
        data.keys().hasOnly(['email', 'assignedDoctorId', 'doctorName', 'approvedByUid', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        isValidId(data.assignedDoctorId) &&
        data.doctorName is string && data.doctorName.size() >= 1 && data.doctorName.size() <= 100 &&
        isValidId(data.approvedByUid) &&
        data.createdAt is timestamp;
    }

    function isValidDoctorRequest(data) {
      return data.keys().hasAll([
          'uid', 'email', 'fullName', 'requestedDoctorId',
          'credentials', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'fullName', 'requestedDoctorId',
          'credentials', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        isValidId(data.requestedDoctorId) &&
        data.credentials is string && data.credentials.size() >= 2 && data.credentials.size() <= 120 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSpecialistRoster(data) {
      return data.keys().hasAll(['dateKey', 'specialists', 'timeWindow', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['dateKey', 'specialists', 'timeWindow', 'updatedByUid', 'updatedAt']) &&
        isValidDate(data.dateKey) &&
        data.specialists is list && data.specialists.size() >= 1 && data.specialists.size() <= 10 &&
        data.specialists[0] is string && data.specialists[0].size() <= 120 &&
        data.timeWindow is string && data.timeWindow.size() >= 1 && data.timeWindow.size() <= 60 &&
        isValidId(data.updatedByUid) &&
        data.updatedAt is timestamp;
    }

    // ---------- Users & Private Mood Entries ----------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isBootstrapAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().role == 'student' ||
          isBootstrapAdmin() ||
          (
            isAllowlistedDoctor() &&
            incoming().role == 'doctor' &&
            incoming().linkedDoctorId == get(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email)).data.assignedDoctorId
          )
        );

      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().linkedDoctorId == existing().linkedDoctorId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'rollNumber', 'uhid', 'hostelOrDept', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            isAllowlistedDoctor() &&
            incoming().role in ['student', 'doctor'] &&
            (
              incoming().role == 'student' ||
              incoming().linkedDoctorId == get(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email)).data.assignedDoctorId
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'linkedDoctorId', 'hostelOrDept', 'rollNumber', 'uhid', 'updatedAt'
            ])
          ) ||
          (
            isBootstrapAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'linkedDoctorId', 'hostelOrDept', 'rollNumber', 'uhid', 'updatedAt'
            ])
          )
        );

      allow delete: if isBootstrapAdmin() && isValidId(userId);

      match /moods/{dateId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidDate(dateId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isEmailVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidDate(dateId) &&
          isValidMoodEntry(incoming()) &&
          incoming().date == dateId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isEmailVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidDate(dateId) &&
          isValidMoodEntry(incoming()) &&
          incoming().date == existing().date &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['score', 'note', 'updatedAt']);
        allow delete: if isEmailVerified() && isOwner(userId) && isValidId(userId) && isValidDate(dateId);
      }
    }

    // ---------- Public Doctor Duty Status ----------
    match /doctor_statuses/{doctorId} {
      allow get: if isValidId(doctorId);
      allow list: if true;

      allow create: if isEmailVerified() &&
        isValidId(doctorId) &&
        isValidDoctorStatus(incoming()) &&
        incoming().doctorId == doctorId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (
          isBootstrapAdmin() ||
          (
            isAllowlistedDoctor() &&
            get(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email)).data.assignedDoctorId == doctorId &&
            incoming().assignedUid == request.auth.uid
          )
        );

      allow update: if isEmailVerified() &&
        isValidId(doctorId) &&
        isValidDoctorStatus(incoming()) &&
        incoming().doctorId == existing().doctorId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'availabilityOverride', 'customNote', 'assignedUid', 'updatedByUid', 'updatedAt'
        ]) &&
        (
          isBootstrapAdmin() ||
          (
            isAllowlistedDoctor() &&
            get(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email)).data.assignedDoctorId == doctorId &&
            incoming().assignedUid == request.auth.uid
          )
        );

      allow delete: if isBootstrapAdmin() && isValidId(doctorId);
    }

    // ---------- Appointments ----------
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (
        existing().studentUid == request.auth.uid ||
        (isEmailVerified() && existing().assignedDoctorUid == request.auth.uid) ||
        isBootstrapAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        (isEmailVerified() && resource.data.assignedDoctorUid == request.auth.uid) ||
        isBootstrapAdmin()
      );

      allow create: if isEmailVerified() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().studentUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().doctorNotes == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            !exists(/databases/$(database)/documents/doctor_statuses/$(incoming().doctorId)) &&
            incoming().assignedDoctorUid == ''
          ) ||
          (
            exists(/databases/$(database)/documents/doctor_statuses/$(incoming().doctorId)) &&
            incoming().assignedDoctorUid == get(/databases/$(database)/documents/doctor_statuses/$(incoming().doctorId)).data.assignedUid
          )
        );

      allow update: if isEmailVerified() &&
        isValidId(appointmentId) &&
        isValidAppointment(incoming()) &&
        incoming().studentUid == existing().studentUid &&
        incoming().doctorId == existing().doctorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        ((existing().status != 'completed' && existing().status != 'cancelled') || isBootstrapAdmin()) &&
        (
          (
            existing().studentUid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['date', 'time', 'reason', 'updatedAt'])
          ) ||
          (
            existing().studentUid == request.auth.uid &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            (existing().assignedDoctorUid == request.auth.uid || isBootstrapAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'doctorNotes', 'updatedAt'])
          ) ||
          (
            isAllowlistedDoctor() &&
            get(/databases/$(database)/documents/doctor_allowlist/$(request.auth.token.email)).data.assignedDoctorId == existing().doctorId &&
            incoming().assignedDoctorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['assignedDoctorUid', 'status', 'doctorNotes', 'updatedAt'])
          )
        );

      allow delete: if isEmailVerified() && isValidId(appointmentId) && (
        existing().studentUid == request.auth.uid || isBootstrapAdmin()
      );
    }

    // ---------- Doctor Allowlist & Verification Requests ----------
    match /doctor_allowlist/{email} {
      allow get: if isEmailVerified() && (email == request.auth.token.email || isBootstrapAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin() &&
        isValidAllowlistEntry(incoming()) &&
        incoming().email == email &&
        incoming().approvedByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isBootstrapAdmin() &&
        isValidAllowlistEntry(incoming()) &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['assignedDoctorId', 'doctorName', 'approvedByUid']);
      allow delete: if isBootstrapAdmin();
    }

    match /doctor_requests/{userId} {
      allow get: if isEmailVerified() && isValidId(userId) && (isOwner(userId) || isBootstrapAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidDoctorRequest(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().email == request.auth.token.email &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isBootstrapAdmin() &&
        isValidId(userId) &&
        isValidDoctorRequest(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isEmailVerified() && isValidId(userId) && (isOwner(userId) || isBootstrapAdmin());
    }

    // ---------- SDM Saturday Visiting Specialists Roster ----------
    match /specialist_roster/{dateKey} {
      allow get: if isValidDate(dateKey);
      allow list: if true;
      allow create, update: if isEmailVerified() &&
        isValidDate(dateKey) &&
        isValidSpecialistRoster(incoming()) &&
        incoming().dateKey == dateKey &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (isBootstrapAdmin() || isAllowlistedDoctor());
      allow delete: if isBootstrapAdmin() && isValidDate(dateKey);
    }
  }
}
